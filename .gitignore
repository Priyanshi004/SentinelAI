@'

# Ignore all Python cache files
__pycache__/
*.py[cod]

# Ignore Jupyter temporary files
.ipynb_checkpoints/
Untitled*.ipynb

# Ignore all generated datasets
dataset/raw/
dataset/processed/
dataset/prepared/
dataset/grouped_v1/

# Ignore trained machine learning models
models/*.joblib
models/*.pkl

# Ignore generated databases
*.db
*.sqlite
*.sqlite3

# Ignore generated API test payloads
backend/*_test_request.json

'@ | Add-Content .\.gitignore